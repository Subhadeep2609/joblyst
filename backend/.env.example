PORT=5000
MONGODB_URI=mongodb://127.0.0.1:27017/job_portal
JWT_SECRET=job_portal_super_secret_jwt_key_2026_secure
JWT_EXPIRES_IN=30d

# Email / Nodemailer configuration (optional for dev, console fallback prints OTP directly)
EMAIL_HOST=smtp.gmail.com
EMAIL_PORT=587
EMAIL_SECURE=false
EMAIL_USER=
EMAIL_PASSWORD=
EMAIL_FROM=JobPortal AI <noreply@jobportal.ai>

# OpenAI API Key (optional for dev, smart heuristic fallback is included)
OPENAI_API_KEY=

CLIENT_URL=http://localhost:5173
GOOGLE_CLIENT_ID=your_google_oauth_client_id_here

# Cloudinary Cloud Storage Configuration (optional for local dev with disk fallback)
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
